# Copy to .env and change the secrets. .env is gitignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ENGINE_USERNAME=world-engine
ENGINE_PASSWORD=change-me-engine
# Shared secret the AI swarm types into the sign-up form so its accounts are labelled AI.
AGENT_INVITE_CODE=change-me-invite

POSTGRES_USER=hivebets
POSTGRES_PASSWORD=hivebets
RABBITMQ_USER=hivebets
RABBITMQ_PASSWORD=hivebets
S3_ACCESS_KEY=hivebets
S3_SECRET_KEY=hivebets-secret
LAKE_BUCKET=hivebets-lake

# Browser-facing gateway URL (used by the web app).
PUBLIC_API_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000

# Phase 2: llama.cpp embedding server running natively on the Mac.
EMBEDDINGS_URL=http://host.docker.internal:8081
# Comma-separated RSS feeds polled by news-service.
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/science_and_environment/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml
# Cosine similarity a real headline needs to be published against a real-world market,
# and above which it counts as a near-duplicate of one already published. Tune after
# looking at the scores on the Admin screen ("Real news ingested").
NEWS_MATCH_THRESHOLD=0.50
NEWS_DUPLICATE_THRESHOLD=0.92
