{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivebets.dev/events/market.resolved.schema.json",
  "title": "market.resolved",
  "description": "Outcome decided and winners paid.",
  "type": "object",
  "required": [
    "marketId",
    "outcome",
    "resolvedAt",
    "payouts"
  ],
  "properties": {
    "marketId": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "enum": [
        "YES",
        "NO"
      ]
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "userId",
          "payoutCents"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "payoutCents": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "examples": [
    {
      "marketId": "5d7e6c1a-6b9f-4d3e-9a51-1f0f6c0c2b11",
      "outcome": "YES",
      "resolvedAt": "2026-11-27T10:11:00Z",
      "payouts": [
        {
          "userId": "0b1f8a35-7c84-4b0e-a2b6-5e6a3d6d9f01",
          "payoutCents": 1000
        }
      ]
    }
  ]
}
