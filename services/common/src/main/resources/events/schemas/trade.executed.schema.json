{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivebets.dev/events/trade.executed.schema.json",
  "title": "trade.executed",
  "description": "One fill. price is in YES terms; takerPrice in the taker's own side terms.",
  "type": "object",
  "required": [
    "id",
    "marketId",
    "price",
    "shares",
    "kind",
    "bidUserId",
    "askUserId",
    "takerUserId",
    "takerUsername",
    "takerSide",
    "takerAction",
    "takerPrice",
    "executedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "marketId": {
      "type": "string",
      "format": "uuid"
    },
    "price": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "shares": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "MINT",
        "TRANSFER_YES",
        "TRANSFER_NO",
        "BURN"
      ]
    },
    "bidOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "askOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "bidUserId": {
      "type": "string",
      "format": "uuid"
    },
    "askUserId": {
      "type": "string",
      "format": "uuid"
    },
    "takerOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "takerUserId": {
      "type": "string",
      "format": "uuid"
    },
    "takerUsername": {
      "type": "string"
    },
    "takerSide": {
      "enum": [
        "YES",
        "NO"
      ]
    },
    "takerAction": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "takerPrice": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "makerUsername": {
      "type": "string"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
