{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivebets.dev/events/order.accepted.schema.json",
  "title": "order.accepted",
  "description": "An order passed validation and reserved cash or shares.",
  "type": "object",
  "required": [
    "orderId",
    "marketId",
    "userId",
    "side",
    "action",
    "price",
    "shares",
    "yesPrice",
    "bookSide"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "marketId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "side": {
      "enum": [
        "YES",
        "NO"
      ]
    },
    "action": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "price": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "shares": {
      "type": "integer",
      "minimum": 1
    },
    "yesPrice": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "bookSide": {
      "enum": [
        "BID",
        "ASK"
      ]
    }
  },
  "examples": [
    {
      "orderId": "3f2e1d0c-9b8a-4765-a4b3-c2d1e0f9a8b7",
      "marketId": "5d7e6c1a-6b9f-4d3e-9a51-1f0f6c0c2b11",
      "userId": "0b1f8a35-7c84-4b0e-a2b6-5e6a3d6d9f01",
      "side": "NO",
      "action": "BUY",
      "price": 40,
      "shares": 10,
      "yesPrice": 60,
      "bookSide": "ASK"
    }
  ]
}
