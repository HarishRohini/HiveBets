{
 "uid": "hivebets-slo",
 "title": "HiveBets SLOs",
 "tags": [
  "hivebets",
  "slo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Order availability: 99.5% of order requests succeed",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Availability over the selected range",
   "description": "Share of trading POSTs (orders) answered without a server error, measured at the gateway so requests that never reached trading-service count too. Target 99.5%.",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\",outcome!=\"SERVER_ERROR\"}[$__range])) / sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Error budget left",
   "description": "Budget = 0.5% of requests may fail. 100% means none of it is used.",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - ((1 - sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\",outcome!=\"SERVER_ERROR\"}[$__range])) / sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\"}[$__range]))) / 0.005)",
     "refId": "A",
     "instant": true
    }
   ],
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "timeseries",
   "title": "Burn rate (1 = spending the budget exactly on schedule)",
   "description": "Fast burn (above 14 on 5 min and 1 h) pages; the alert rule 'Order API error rate above 1%' is a simpler stand-in.",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 14
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\",outcome=\"SERVER_ERROR\"}[5m])) or vector(0)) / sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\"}[5m])) / 0.005",
     "legendFormat": "5 min",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\",outcome=\"SERVER_ERROR\"}[1h])) or vector(0)) / sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"trading\",httpMethod=\"POST\"}[1h])) / 0.005",
     "legendFormat": "1 h",
     "refId": "B"
    }
   ],
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "row",
